# Copy this file to .env and fill in your values.

# How often to check for new trades (seconds). Spec: 1-5.
POLL_INTERVAL_SECONDS=10

# Path to MT5 terminal (recommended — set explicitly on Windows).
MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Telegram Bot (create via @BotFather)
# One recipient: TELEGRAM_CHAT_ID=123456789
# Multiple recipients (you + partner): TELEGRAM_CHAT_ID=123456789,987654321
# Or use one shared group chat ID instead.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Account 1 (required for initial testing)
MT5_LOGIN_1=12345678
MT5_PASSWORD_1=your_investor_password
MT5_SERVER_1=YourBroker-Server
MT5_ACCOUNT_LABEL_1=Main Account

# Account 2 — Agile Global Ltd (server name must match MT5 exactly, e.g. AgileGlobal-Server)
MT5_LOGIN_2=87654321
MT5_PASSWORD_2=your_investor_password
MT5_SERVER_2=AgileGlobal-Server
MT5_ACCOUNT_LABEL_2=Agile Account

# Optional per-account MT5 path if brokers use separate installs:
# MT5_TERMINAL_PATH_2=C:/Program Files/Agile Global MT5/terminal64.exe

# Optional: add up to 3 more accounts (MT5_LOGIN_3 ... MT5_LOGIN_5)
