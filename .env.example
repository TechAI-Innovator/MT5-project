# Copy this file to .env and fill in your values.

# How often to check for new trades (seconds). Spec: 1-5.
POLL_INTERVAL_SECONDS=5

# Path to MT5 terminal (recommended — set explicitly on Windows).
MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Telegram Bot (create via @BotFather)
# One recipient: TELEGRAM_CHAT_ID=123456789
# Multiple recipients: TELEGRAM_CHAT_ID=123456789,987654321
# Or one shared group chat ID.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Open-trade acknowledgement (Seen button)
ACK_REMIND_SECONDS=30
ACK_MAX_REMINDERS=5

# Log rotation
LOG_MAX_MB=4
LOG_BACKUP_COUNT=2

# Account 1
MT5_LOGIN_1=12345678
MT5_PASSWORD_1=your_investor_password
MT5_SERVER_1=YourBroker-Server
MT5_ACCOUNT_LABEL_1=Main Account

# Optional per-account terminal path:
# MT5_TERMINAL_PATH_1=C:/Program Files/MetaTrader 5/terminal64.exe

# Add more accounts as MT5_LOGIN_2 ... MT5_LOGIN_50
